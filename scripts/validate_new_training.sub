#!/usr/bin/env condor_submit
# Validate model with new chirp-warped training data
#
# Training data: q ∈ {0.1, 0.8, 1.0} with chirp warping α=0.625
# Test points: Full range including q=1.0

universe = vanilla
executable = /home/daniel/repositories/ligo/heron/scripts/run_with_gpu.sh
should_transfer_files = NO

# Request GPU
request_gpus = 1
request_cpus = 1
request_memory = 8GB

# Arguments: wrapper script will run Python with mass ratio
arguments = validate_with_new_training_data.py $(q)
initialdir = /home/daniel/repositories/ligo/heron/scripts

# Logging
log = condor_logs/new_train_$(Cluster).$(Process).log
output = condor_logs/new_train_q$(q).out
error = condor_logs/new_train_q$(q).err

# Test mass ratios including q=1.0
queue q from (
    0.1
    0.3
    0.5
    0.7
    0.8
    0.9
    1.0
)
