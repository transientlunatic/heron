# HTCondor submit file for time-warping comparison tests
# Tests simple vs chirp warping with different iteration counts

universe                = vanilla
request_gpus            = 1
request_cpus            = 1
request_memory          = 8GB

# Use wrapper script to set up GPU environment
executable              = /home/daniel/repositories/ligo/heron/scripts/run_with_gpu.sh
arguments               = scripts/test_warping_comparison.py $(warping) $(iterations)

# Use shared filesystem instead of file transfer
should_transfer_files   = NO

# Set initial directory (where the job will run and logs will be written)
initialdir              = /home/daniel/repositories/ligo/heron

# Logs and output
log                     = scripts/condor_logs/warp_$(warping)_$(iterations).log
output                  = scripts/condor_logs/warp_$(warping)_$(iterations).out
error                   = scripts/condor_logs/warp_$(warping)_$(iterations).err

# Set environment variables for Python
environment             = "PYTHONPATH=/home/daniel/repositories/ligo/heron"

# Queue jobs for different warping types and iteration counts
# Test both simple and chirp warping at 500, 1000, and 1500 iterations
queue warping,iterations from (
simple 500
simple 1000
simple 1500
chirp 500
chirp 1000
chirp 1500
)
