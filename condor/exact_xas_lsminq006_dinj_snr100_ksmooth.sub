# k-smoothing validation, SNR~100 arm (distance=300 Mpc), WITH-K, k-smoothing ON.
# --k-smoothing-grid-spacing 0.03 (dense30 q-spacing). Recovers the injected q
# where the _nosmooth counterpart snaps. Same seed=42 => identical noise realization.
universe        = vanilla
executable      = condor/run_ns_exact_xas_lsminq006_dinj.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag) --distance 300 --k-smoothing-grid-spacing 0.03
output          = condor_logs/ns_exact_lsminq006_dinj_$(qtag).out
error           = condor_logs/ns_exact_lsminq006_dinj_$(qtag).err
log             = condor_logs/ns_exact_lsminq006_dinj_$(qtag).log

queue q,qtag from (
    0.50, q050_snr100_ksmooth
    0.60, q060_snr100_ksmooth
    0.80, q080_snr100_ksmooth
)
