# REALISTIC-SNR arm: clean IMRPhenomD injection at distance=1500 Mpc
# (SNR~20, representative of a real detection -- GW150914 was ~24), WITH-K,
# against the ls_min_q=0.06 plus/cross ExactGPSurrogate+XAS checkpoint.
#
# Purpose: the log-det/K effect scales ~K/C ~ SNR^2/N, so at SNR~20 it is
# ~(20/300)^2 ~ 1/225 of the SNR~300 arm. This is the first CLEAN realistic-SNR
# test now that the luminosity_distance bug is fixed (the earlier "SNR~100
# attractor" was that bug -- see memory snr100_universal_attractor). Compare
# with the SNR~300 arm (dag_exact_xas_dinj.dag) and the no-K counterpart.
universe        = vanilla
executable      = condor/run_ns_exact_xas_lsminq006_dinj.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag) --distance 1500
output          = condor_logs/ns_exact_lsminq006_dinj_$(qtag).out
error           = condor_logs/ns_exact_lsminq006_dinj_$(qtag).err
log             = condor_logs/ns_exact_lsminq006_dinj_$(qtag).log

queue q,qtag from (
    0.50, q050_snr20_withK
    0.60, q060_snr20_withK
    0.80, q080_snr20_withK
)
