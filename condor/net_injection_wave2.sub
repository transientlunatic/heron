# Wave 2: full 8-D extrinsic + sky-localization network-injection PE tests
# (H1+L1+V1, sampling mass_ratio, tc, ra, dec, psi, luminosity_distance,
# inclination, coalescence_phase). DemodGPSurrogate, IMRPhenomD injection,
# distance=1500 Mpc (net SNR ~22 across 3 detectors), nessai nlive=250, CPU.
# The headline machinery test: does the full network PE recover an injected
# signal across all extrinsic parameters, with-K vs no-K. Expensive (3x predict
# per call, 8-D) -- submit only after wave 1 confirms the path works.
universe        = vanilla
executable      = condor/run_net_injection.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_cpus    = 4
request_memory  = 6144
should_transfer_files = NO
getenv          = false
arguments       = $(tag)
output          = condor_logs/net_$(tag).out
error           = condor_logs/net_$(tag).err
log             = condor_logs/net_$(tag).log

queue tag from (
    net8d_h1l1v1_withK
    net8d_h1l1v1_noK
)
