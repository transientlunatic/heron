# Matched-family (IMRPhenomXAS) injection, with-K, against the
# ls_min_q=0.06-fixed phase-amplitude XAS checkpoint. Same three
# off-training-grid q's used throughout this investigation (0.50/0.60/0.80).
# Part of dag_matched_lsminq006.dag -- no parent, can run immediately.
universe        = vanilla
executable      = condor/run_ns_pa_xas_lsminq006_matched.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag)
output          = condor_logs/ns_pa_lsminq006_matched_$(qtag).out
error           = condor_logs/ns_pa_lsminq006_matched_$(qtag).err
log             = condor_logs/ns_pa_lsminq006_matched_$(qtag).log

queue q,qtag from (
    0.50, q050_withK
    0.60, q060_withK
    0.80, q080_withK
)
