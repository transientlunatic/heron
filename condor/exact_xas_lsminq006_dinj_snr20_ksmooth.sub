# k-smoothing validation, SNR~20 arm (distance=1500 Mpc), WITH-K, k-smoothing ON.
# --k-smoothing-grid-spacing 0.03 = dense30's q training-grid spacing; the
# likelihood envelopes (elementwise-max) K over 4 offsets spanning +/- half a
# grid period, removing the grid-periodic K-variance dip that snaps the posterior
# to training nodes. If the fix works, this recovers the injected q where the
# _nosmooth counterpart snaps. Same seed=42 => identical noise realization.
universe        = vanilla
executable      = condor/run_ns_exact_xas_lsminq006_dinj.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag) --distance 1500 --k-smoothing-grid-spacing 0.03
output          = condor_logs/ns_exact_lsminq006_dinj_$(qtag).out
error           = condor_logs/ns_exact_lsminq006_dinj_$(qtag).err
log             = condor_logs/ns_exact_lsminq006_dinj_$(qtag).log

queue q,qtag from (
    0.50, q050_snr20_ksmooth
    0.60, q060_snr20_ksmooth
    0.80, q080_snr20_ksmooth
)
