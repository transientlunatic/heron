# No-K (matched-filter) companion to scan_pa_xas_lsminq006.sub -- needed to
# directly test whether the with-K posterior broadens sensibly relative to
# the no-K one on the RETRAINED (ls_min_q=0.06) checkpoint, the same way
# results/compare_q025_withK_vs_noK.png did for the original checkpoint at
# an on-grid q. Same three off-grid q's (0.50/0.60/0.80), same wide prior,
# default IMRPhenomD injection.
universe        = vanilla
executable      = condor/run_ns_pa_xas_lsminq006.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk") || (Machine == "puck.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag)_nounc --no-uncertainty
output          = condor_logs/ns_pa_xas_lsminq006_$(qtag)_nounc.out
error           = condor_logs/ns_pa_xas_lsminq006_$(qtag)_nounc.err
log             = condor_logs/ns_pa_xas_lsminq006_$(qtag)_nounc.log

queue q,qtag from (
    0.50, q050
    0.60, q060
    0.80, q080
)
