# k-smoothing validation, SNR~100 arm (distance=300 Mpc), WITH-K, NO smoothing.
# Intermediate SNR between the SNR~300 arm (no bias, memory exact_xas_no_logdet_bias)
# and the SNR~20 realistic arm. Baseline that may show partial grid-snap; compare
# against the _ksmooth counterpart (same seed=42 => same noise realization).
universe        = vanilla
executable      = condor/run_ns_exact_xas_lsminq006_dinj.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag) --distance 300
output          = condor_logs/ns_exact_lsminq006_dinj_$(qtag).out
error           = condor_logs/ns_exact_lsminq006_dinj_$(qtag).err
log             = condor_logs/ns_exact_lsminq006_dinj_$(qtag).log

queue q,qtag from (
    0.50, q050_snr100_nosmooth
    0.60, q060_snr100_nosmooth
    0.80, q080_snr100_nosmooth
)
