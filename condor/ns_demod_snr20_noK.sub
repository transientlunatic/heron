# DemodGPSurrogate, IMRPhenomD injection, distance=1500 Mpc (SNR~20), WITHOUT-K
# (matched-filter control). Pairs with ns_demod_snr20_withK.sub: the no-K/with-K
# difference isolates the GP-marginalisation (log-det) effect from any residual
# mean/mismatch offset. With demod's ~1e-5 mismatch, no-K should sit essentially
# on truth, and with-K should stay there too if K is small enough not to bias.
universe        = vanilla
executable      = condor/run_ns_demod_dinj.sh
requirements    = (Machine == "wiay.astro.gla.ac.uk")
request_gpus    = 1
request_cpus    = 2
request_memory  = 4096
should_transfer_files = NO
getenv          = false
arguments       = $(q) $(qtag) --distance 1500 --no-uncertainty
output          = condor_logs/ns_demod_dinj_$(qtag).out
error           = condor_logs/ns_demod_dinj_$(qtag).err
log             = condor_logs/ns_demod_dinj_$(qtag).log

queue q,qtag from (
    0.50, q050_snr20_noK
    0.60, q060_snr20_noK
    0.80, q080_snr20_noK
)
